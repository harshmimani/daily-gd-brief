+    )
+    if d.get("ai"):
+        s.summary = d.get("summary", "")
+        s.why_it_matters = d.get("why_it_matters", "")
+        s.gd_for = list(d.get("gd_for") or [])
+        s.gd_against = list(d.get("gd_against") or [])
+        s.key_fact = d.get("key_fact", "")
+        s.ai = True
